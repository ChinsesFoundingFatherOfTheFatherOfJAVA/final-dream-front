    },
    {
      "id": "tag-time",
      "selector": ".fs-tabbar + div > div > div:nth-child(2) > div > button span.bg-amber-50",
      "props": ["height", "paddingX", "paddingY", "radius", "fontSize", "fontWeight", "lineHeight", "color", "background"]
    },
    {
      "id": "toggle",
      "selector": ".fs-tabbar + div > div > div:nth-child(2) > div > button > div:nth-child(2)",
