      "props": ["height", "gap", "display"]
    },
    {
      "id": "seq",
      "selector": ".fs-tabbar + div > div > div:nth-child(2) > div > button > div:nth-child(1) > div:nth-child(1)",
      "props": ["width", "height", "radius", "fontSize", "fontWeight", "color", "background"]
    },
    {
      "id": "unit-name",
      "selector": ".fs-tabbar + div > div > div:nth-child(2) > div > button > div:nth-child(1) > div:nth-child(2) > div:nth-child(1)",
      "props": ["height", "fontSize", "fontWeight", "lineHeight", "color"]
    },
    {
      "id": "meta",
      "selector": ".fs-tabbar + div > div > div:nth-child(2) > div > button > div:nth-child(1) > div:nth-child(2) > div:nth-child(2)",
