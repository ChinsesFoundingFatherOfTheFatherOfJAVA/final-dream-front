{
  "name": "front-end",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write --experimental-cli src/",
    "visual:capture": "node scripts/visual-capture.mjs",
    "visual:audit": "node scripts/visual-audit.mjs",
    "visual:selftest": "node scripts/visual-contract-selftest.mjs",
    "visual:check": "node scripts/visual-contract-selftest.mjs && node scripts/visual-audit.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "hls.js": "^1.7.3",
    "pinia": "^4.0.3",
    "sass": "^1.104.0",
    "vue": "3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {}
}
