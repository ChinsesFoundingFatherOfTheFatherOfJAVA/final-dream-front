/** 构造演示 artifact（无案例时 cases 为空，generate_cases 后逐个补） */
export function buildMockArtifactContent(withCases = false): AssistantArtifactContent {
  return {
    materials: [
      {
        id: 'mat-1',
        name: '订单运营部职能介绍',
        fileType: 'pptx',
        fileSize: 2,
        fileSizeUnit: 'M',
        visibility: 1,
        fileServId: '3a20',
        fileSource: 2,
        targetId: ''
      }
    ],
    scenarios: SCENARIO_SPECS.map((s) => ({
      id: s.id,
      name: s.name,
      audiences: s.audiences,
      businessGoal: s.businessGoal,
      behaviorGoals: s.goals,
      relatedIcebergElements: {
        knowledge: s.iceberg.knowledge,
        skills: s.iceberg.skills,
        roles: s.iceberg.roles,
        selfConcept: s.iceberg.selfConcept,
        personalities: s.iceberg.personalities,
        motives: s.iceberg.motives
      },
      businessImpact: s.businessImpact,
      failureCost: s.failureCost,
      coreConflict: s.coreConflict,
      failureReasons: s.failureReasons,
      difficulties: s.difficulties,
      constraints: { forbidBehaviors: s.forbidBehaviors, maxTime: s.maxTime },
      relatedKnowledgeIds: [],
      relatedScriptIds: [],
      relatedProductProfileArtifactIds: [],
      caseArtifactIds: [],
      cases: withCases ? [withDifficulty(s.case)] : [],
      dimensionWeights: defaultWeights.map((w) => ({ ...w }))
    })),
    customerProfiles: [
      {
        id: 'cp-1',
        type: '技术型决策者',
        description: '关注系统架构完整性与技术可行性，需要清晰的实现路径与落地节奏',
        personalities: ['严谨', '务实', '重视数据'],
        decisionFactors: ['方案完整性', '技术可落地性', '同行案例'],
        communicationStyle: '语速中等，喜欢追问细节与实现路径',
        painPoints: ['方案零散无体系', '供应商过度承诺', '实施周期不可控']
      },
      {
        id: 'cp-2',
        type: '成本敏感型决策参与者',
        description: '关注投入产出比与量化收益，对承诺持谨慎态度',
        personalities: ['直接', '怀疑', '精于测算'],
        decisionFactors: ['投入产出比', '数据口径可信度', '见效周期'],
        communicationStyle: '提问犀利，常打断并追问数字来源',
        painPoints: ['效益无法量化', '历史项目未达预期', '隐性成本']
      },
      {
        id: 'cp-3',
        type: '高层决策者',
        description: '关注战略价值与行业格局，希望方案支撑业务转型目标',
        personalities: ['视野开阔', '结果导向'],
        decisionFactors: ['战略契合度', '转型支撑能力', '行业标杆效应'],
        communicationStyle: '语速快，常直接给结论',
        painPoints: ['小单快反响应慢', '爆品打不出来', '库存与测款风险']
      }
    ],
    icebergModel: {
      visible: {
        knowledge: ['系统架构认知', '场景功能区分', '量化指标口径', '智能裁剪原理', '产中齐套逻辑', '分拣识别技术', '行业趋势'],
        skills: ['结构化表达', '基础话术运用', '技术型销售顾问', '数据引用', '效益测算', '对比表达', '异议处理', '战略表达', '价值整合']
      },
      hidden: {
        roles: ['专业可信', '客户导向', '顾问式销售', '技术解读者', '问题解决者', '战略伙伴'],
        selfConcept: ['耐心细致', '务实严谨', '专业自信', '沉着应对', '全局视角'],
        personalities: ['积极主动', '细心', '逻辑清晰', '抗压能力强', '有感染力'],
        motives: ['建立信任', '传递价值', '降低客户决策风险', '消除疑虑', '建立技术信任', '促成决策']
      }
    },
    evaluationCriteria: {
      passScore: 70,
      dimensions: DIMENSIONS.map((d) => ({ ...d })),
      defaultDimensionWeights: defaultWeights.map((w) => ({ ...w }))
