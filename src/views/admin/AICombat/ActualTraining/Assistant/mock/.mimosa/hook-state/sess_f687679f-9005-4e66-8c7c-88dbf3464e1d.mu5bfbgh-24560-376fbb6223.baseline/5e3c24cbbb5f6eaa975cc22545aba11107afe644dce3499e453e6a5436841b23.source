// ============================================================
// Mock 会话状态（内存，刷新即重置）
// ============================================================

const MOCK_THEME_ID = '1948000000000000001'

interface MockState {
  sessionId: string
  themeId: string | null
  artifact: AssistantArtifactSnapshot | null
  messages: AssistantMessageItem[]
  /** 是否已触发 topic-changed（右面板展开） */
  topicCreated: boolean
}

const state: MockState = {
  sessionId: 'mock-session-0001',
  themeId: null,
  artifact: null,
  messages: [],
  topicCreated: false
}

function newArtifactSnapshot(content: AssistantArtifactContent | null): AssistantArtifactSnapshot {
  return { artifactId: '7556000000000000001', versionNo: '1', status: 'working', content }
}

/** 会话往返时间（mock 传输层统一延迟） */
const MOCK_DELAY = 120

// ============================================================
// §2 HTTP Mock
// ============================================================

export function mockCreateSession(themeId?: string): AssistantSessionResp {
  if (themeId) {
    // 带 themeId 进入：视作复用既有会话（FP-31 恢复）
    state.themeId = themeId
    state.topicCreated = true
    if (!state.artifact) state.artifact = newArtifactSnapshot(buildMockArtifactContent(true))
  } else if (!state.themeId) {
    state.artifact = null
  }
  return { sessionId: state.sessionId, themeId: state.themeId, isNew: !themeId, artifact: state.artifact }
}

export function mockGetMessages(): { messages: AssistantMessageItem[]; pagination: { limit: number; hasNextPage: boolean; nextCursor: string } } {
  return {
    messages: state.messages.map((m) => ({ ...m })),
    pagination: { limit: 1000, hasNextPage: false, nextCursor: '' }
  }
}

export function mockGetArtifact(): AssistantArtifactSnapshot | null {
  return state.artifact
}

export function mockUploadFile(name: string, fileType: string, fileSize: number): AssistantFileResp {
  return {
    fileId: `file-${Date.now()}`,
    name: name.replace(/\.[^.]+$/, ''),
    fileType,
    fileSize
  }
}

export function mockAsr(): string {
  return '希望快速上手，针对于新入职人员'
}

export function mockPublish(): { status: number; totalCases: number } {
  return { status: 1, totalCases: SCENARIO_SPECS.length }
}

export function mockScriptProgress(): AssistantScriptProgressResp {
  const total = SCENARIO_SPECS.length
  const tick = (progressTick += 1)
  const completed = Math.min(total, Math.ceil((tick / 4) * total))
  return {
    total,
    completed,
    failed: 0,
    progress: total === 0 ? 100 : Math.round((completed / total) * 100),
    status: completed >= total ? 3 : 1
  }
}

let progressTick = 0

/** publish 后重新计时（每次发布进度从 0 开始） */
export function mockResetProgress(): void {
  progressTick = 0
}

// ============================================================
// 假 WS 传输：与浏览器 WebSocket 同形（onopen/onmessage/onclose/send/close）
// ============================================================

type FrameHandler = (frame: AssistantServerFrame) => void

function now(): string {
  const d = new Date()
  const p = (n: number, len = 2) => String(n).padStart(len, '0')
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`
}

/** 单轮事件的 seq 与 part index 管理器（§3.3：seq 单轮内从 1 递增） */
class FrameRound {
  private seq = 0
  private index = 0

  constructor(
    private readonly emit: FrameHandler,
    private readonly messageId: string
  ) {}

  private base(extra: Record<string, unknown>): Record<string, unknown> {
    this.seq += 1
    return { ...extra, messageId: this.messageId, seq: this.seq }
  }

  event(event: string, data: Record<string, unknown>): void {
    this.emit({ type: 'event', event, data } as unknown as AssistantServerFrame)
  }

  /** 轮次开始：session-start + message-extra-info + message-start */
  openRound(): void {
    this.event('session-start', {
      sessionId: state.sessionId,
      traceId: randomHex(32),
      timestamp: now(),
      seq: ++this.seq
    })
    this.event('message-extra-info', {
      messageId: this.messageId,
      extraInfo: { taskId: randomHex(16), contextId: randomHex(16) }
    })
    this.event('message-start', {
      messageId: this.messageId,
      sender: { id: 'agent-side-free', name: 'Nova', avatar: '' },
      agentMessageDbId: randomHex(16),
      agentMessageCreatedAt: now()
    })
  }

  /** text part：part-start → N×part-content(text_delta) → part-end */
  textPart(text: string, chunkSize = 12): void {
    this.index += 1
    const index = this.index
    this.event('part-start', {
      index,
      type: 'PART_START',
      timestamp: now(),
      contentType: 'text',
      partExtendedData: { partType: 'text' },
      messageExtendedData: { version: 1 },
      messageId: this.messageId,
      seq: ++this.seq
    })
    for (let i = 0; i < text.length; i += chunkSize) {
      this.event('part-content', {
        index,
        type: 'PART_CONTENT',
        timestamp: now(),
        delta: { type: 'text_delta', text: text.slice(i, i + chunkSize) },
        messageId: this.messageId,
        seq: ++this.seq
      })
    }
    this.event('part-end', { index, type: 'PART_END', timestamp: now(), messageId: this.messageId, seq: ++this.seq })
  }

  /** data part：payload 序列化为 JSON 后按片段流式（data_delta），前端 part-end 整体解析 */
  dataPart(payload: { bizType: string; params: Record<string, unknown> }, chunkSize = 24): void {
    this.index += 1
    const index = this.index
    const json = JSON.stringify(payload, null, 2)
    this.event('part-start', {
      index,
      type: 'PART_START',
      timestamp: now(),
      contentType: 'data',
      partExtendedData: { partType: 'data' },
      messageExtendedData: { version: 1 },
      messageId: this.messageId,
      seq: ++this.seq
    })
    for (let i = 0; i < json.length; i += chunkSize) {
      this.event('part-content', {
        index,
        type: 'PART_CONTENT',
        timestamp: now(),
        delta: { type: 'data_delta', data: json.slice(i, i + chunkSize) },
        messageId: this.messageId,
        seq: ++this.seq
      })
    }
    this.event('part-end', { index, type: 'PART_END', timestamp: now(), messageId: this.messageId, seq: ++this.seq })
  }

  finish(): void {
    this.event('session-finish', { sessionId: state.sessionId, timestamp: now() })
  }
}

let idCounter = 0

/** 随机十六进制串（traceId/spanId/messageId 均为关联标识，取加密安全随机源） */
function randomHex(len: number): string {
  const bytes = new Uint8Array(Math.ceil(len / 2))
  if (typeof crypto !== 'undefined' && typeof crypto.getRandomValues === 'function') {
    crypto.getRandomValues(bytes)
  } else {
    // 非安全上下文兜底：crypto 缺失时用时间戳+自增计数，保证唯一即可（mock 标识不参与鉴权）
    idCounter += 1
    const seed = `${Date.now()}${idCounter}`
    for (let i = 0; i < bytes.length; i++) {
      bytes[i] = Number(seed.slice(i % seed.length, (i % seed.length) + 2)) || 0
    }
  }
  let s = ''
  for (const b of bytes) s += b.toString(16).padStart(2, '0')
  return s.slice(0, len)
}

/** 假 WS：把 03 §3 的事件序列按真实节奏吐给调用方 */
export class MockAssistantSocket {
  onopen: (() => void) | null = null
  onmessage: ((ev: { data: string }) => void) | null = null
  onclose: ((ev?: { code: number; reason: string }) => void) | null = null
  onerror: ((ev?: unknown) => void) | null = null

  readyState = 0
  private timers: number[] = []
  private closed = false
  private pingTimer: number | null = null
  private messageSeq = 0

  constructor(public readonly url: string) {
    this.timers.push(
      window.setTimeout(() => {
        if (this.closed) return
        this.readyState = 1
        this.onopen?.()
        // 服务端心跳（§3.1）：连上后周期性 ping，验证客户端自动回 pong
        this.pingTimer = window.setInterval(() => {
          this.push({ type: 'ping', ts: Date.now() })
        }, 25000)
      }, 60)
    )
  }

  private push(frame: AssistantServerFrame): void {
    if (this.closed) return
    this.onmessage?.({ data: JSON.stringify(frame) })
  }

  /** 按 delay 排期一串帧，模拟 80ms 节流后的节奏 */
  private play(frames: (() => void)[], step = 40): void {
    frames.forEach((fn, i) => {
      this.timers.push(
        window.setTimeout(() => {
          if (!this.closed) fn()
        }, step * i)
      )
    })
  }

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  send(raw: string): void {
    let frame: any
    try {
      frame = JSON.parse(raw)
    } catch {
      return
    }
    if (frame?.type === 'pong') return

    if (frame?.type === 'chat') {
      const message = frame.payload?.message
      const blocks = message?.content ?? []
      const actionBlock = blocks.find((b: { type: string }) => b.type === 'data')
      if (actionBlock) {
        this.handleAction(actionBlock.data?.actionName, actionBlock.data?.params ?? {})
        return
      }
      const fileBlock = blocks.find((b: { type: string }) => b.type === 'file')
      if (fileBlock) {
        this.handleFileUpload(fileBlock)
        return
      }
      const textBlock = blocks.find((b: { type: string }) => b.type === 'text')
      this.handleUserText(String(textBlock?.text ?? ''), message?.id ?? '')
      return
    }
  }

  /** common-session-start → 开场白；biz-side-manage-confirm → save-success；update-material → artifact-updated */
  private handleAction(actionName: string, params: Record<string, unknown>): void {
    if (actionName === 'common-session-start') {
      this.round((r) => {
        r.textPart(this.openingText())
      })
      return
    }
    if (actionName === 'biz-side-manage-confirm') {
      const artifactId = String(params.id ?? state.artifact?.artifactId ?? '')
      const version = String(params.version ?? state.artifact?.versionNo ?? '1')
      if (state.artifact) {
        state.artifact = { ...state.artifact, status: 'confirmed' }
      }
      this.round((r) => {
        r.dataPart({
          bizType: 'biz-side-manage-save-success',
          params: { id: artifactId, version, ex_id: state.themeId ?? MOCK_THEME_ID }
        })
        r.textPart('已保存当前内容到主题，可在主题详情中查看。')
      })
      return
    }
    if (actionName === 'biz-side-manage-update-material') {
      const materialId = String(params.materialId ?? '')
      const visibility = Number(params.visibility ?? 1)
      const content = state.artifact?.content
      if (content) {
        content.materials = content.materials.map((m) => (m.id === materialId ? { ...m, visibility } : m))
        state.artifact = { ...state.artifact, content: { ...content } }
      }
      this.round((r) => {
        r.dataPart({
          bizType: 'biz-side-manage-artifact-updated',
          params: {
            id: state.artifact?.artifactId ?? '',
            version: state.artifact?.versionNo ?? '1',
            content: [{ op: 'full_replace', path: '/materials', value: content?.materials ?? [], reason: 'Toggle material visibility' }]
          }
        })
      })
      return
    }
  }

  /** 文件块 → 解析中(0) → 解析完成(1)，并把材料并入 artifact.materials */
  private handleFileUpload(fileBlock: { file: { uri: string }; extendedData: { name: string; fileType: string; fileSize: number } }): void {
    const fileId = fileBlock.file.uri
    const name = fileBlock.extendedData?.name ?? '未命名材料'
    const contextId = randomHex(16)
    const content = state.artifact?.content ?? buildMockArtifactContent(true)
    const materials = [
      ...content.materials.filter((m) => m.id !== fileId),
      {
        id: fileId,
        name: name.replace(/\.[^.]+$/, ''),
        fileType: fileBlock.extendedData?.fileType ?? 'pptx',
        fileSize: Math.max(1, Math.round((fileBlock.extendedData?.fileSize ?? 0) / 1024 / 1024)),
        fileSizeUnit: 'M',
        visibility: 1,
        fileServId: fileId,
        fileSource: 2,
        targetId: ''
      }
    ]
    content.materials = materials
    state.artifact = state.artifact ? { ...state.artifact, content: { ...content } } : newArtifactSnapshot(content)

    this.round((r) => {
      // 解析中（status 0）
      r.dataPart({
        bizType: 'biz-common-parse-file',
        params: {
          context_id: contextId,
          call_id: contextId,
          content: `开始解析文件：${name}`,
          files: [{ id: fileId, name, status: 0 }]
        }
      })
      // 解析完成（status 1）+ 材料并入 artifact
      r.dataPart({
        bizType: 'biz-common-parse-file',
        params: {
          context_id: contextId,
          call_id: contextId,
          content: `文件解析完成：${name}，已提取内容要点并加入培训材料。`,
          files: [{ id: fileId, name, status: 1 }]
        }
      })
      r.dataPart({
        bizType: 'biz-side-manage-artifact-updated',
        params: {
          id: state.artifact?.artifactId ?? '',
          version: state.artifact?.versionNo ?? '1',
          content: [{ op: 'full_replace', path: '/materials', value: materials, reason: 'Add uploaded material' }]
        }
      })
      r.textPart(`已解析《${name}》。我从材料中提取到以下要点：\n\n- 部门职责与关键协作节点\n- 订单处理的标准流程\n- 异常场景的处理规范\n\n要不要我基于这份材料生成训练主题？`)
    })
  }

  /** 用户文本 → 按关键词给出脚本化响应（含 topic-changed / generate 全链路） */
  private handleUserText(text: string, userMessageId: string): void {
    // 1. 回执：user-message-ack 属于上一轮，此处模拟服务端先回执用户消息
    this.push({
      type: 'event',
      event: 'user-message-ack',
      data: { userMessageDbId: randomHex(16), userMessageId }
    } as unknown as AssistantServerFrame)

    // 2. 首次给足方向 → 建草稿 + topic-changed（FP-39 / FP-33 展开右面板）
    const needTopic = !state.topicCreated && text.trim().length > 0

    if (/确认|保存/.test(text) && state.artifact) {
      this.round((r) => {
        r.dataPart({
          bizType: 'biz-side-manage-save-success',
          params: { id: state.artifact?.artifactId ?? '', version: state.artifact?.versionNo ?? '1', ex_id: state.themeId ?? MOCK_THEME_ID }
        })
        r.textPart('已按当前内容保存到主题，你可以在主题详情页查看场景单元与评估标准。')
      })
      return
    }

    const wantGenerate = /生成|出题|做一版|产生/.test(text)
    const wantCases = /案例|剧本/.test(text)

    this.round((r) => {
      if (needTopic) {
        // topic-changed：右面板展开（FP-33 GWT）
        state.themeId = state.themeId ?? MOCK_THEME_ID
        state.topicCreated = true
        r.textPart(
          '好的，我先按你的方向把主题框架定下来：\n\n' +
            '| 项目 | 内容 |\n| --- | --- |\n| 主题方向 | 新入职销售的柔性智造方案讲解能力 |\n| 目标人群 | 新入职销售 |\n| 训练重点 | 系统定位表达、量化指标引用、异议处理 |\n\n' +
            '我已经创建了草稿主题「柔性智造销售话术训练」，右侧面板可以先看到框架。接下来想确认两个细节：'
        )
        r.dataPart({
          bizType: 'biz-side-manage-topic-changed',
          params: {
            explicit: true,
            topic: '柔性智造销售话术训练',
            description: '面向新入职销售，围绕柔性智造运营管理系统六大场景展开实战演练'
          }
        })
        r.dataPart({
          bizType: 'biz-side-manage-artifact-updated',
          params: {
            id: state.artifact?.artifactId ?? '7556000000000000001',
            version: '1',
            content: [{ op: 'full_replace', path: '/materials', value: state.artifact?.content?.materials ?? [], reason: 'Init materials' }]
          }
        })
        r.textPart('1. 训练的人群就是新入职销售，还是也要覆盖在职销售？\n2. 单个场景的演练时长按 10~15 分钟设计可以吗？')
        return
      }

      if (wantCases && !wantGenerate) {
        const content = state.artifact?.content ?? buildMockArtifactContent(true)
        const targets = content.scenarios.filter((s) => s.cases.length === 0)
        if (targets.length === 0) {
          r.textPart('当前所有场景都已经有案例了。需要我调整某个案例的角色设定或开场白吗？')
          return
        }
        r.textPart('> 正在生成中等难度的实战案例，请稍候...')
        this.play(
          targets.map((s) => () => {
            r.dataPart({
              bizType: 'biz-side-manage-case-generated',
              params: {
                id: state.artifact?.artifactId ?? '',
                jsonArtifactId: state.artifact?.artifactId ?? '',
                scenarioId: s.id,
                subjectId: s.id,
                scriptName: s.case.scriptName,
                difficulty: s.case.difficulty,
                status: 'completed'
              }
            })
          }),
          6
        )
        // 案例正文不入事件流：模拟从 artifact 拉取（store 收到 case-generated 后刷新）
        this.timers.push(
          window.setTimeout(() => {
            if (this.closed) return
            const c = state.artifact?.content
            if (c) {
              c.scenarios = c.scenarios.map((s) => (s.cases.length === 0 ? { ...s, cases: [specCase(s.id)], caseArtifactIds: [''] } : s))
              state.artifact = { ...state.artifact!, content: { ...c } }
            }
          }, 200)
        )
        r.textPart(`已经为 ${targets.length} 个场景各生成 1 个实战案例，难度默认中等。右侧「场景单元」Tab 可以看到案例卡。`)
        return
      }

      if (wantGenerate) {
        r.textPart('> 正在生成等难度的实战案例，请稍候...')
        // in_progress：先给场景列表（渐次渲染）
        const partial = buildMockArtifactContent(false)
        r.dataPart({
          bizType: 'biz-side-manage-artifact-generated',
          params: {
            id: state.artifact?.artifactId ?? '7556000000000000001',
            version: '1',
            status: 'in_progress',
            content: { scenarios: partial.scenarios, materials: partial.materials }
          }
        })
        this.timers.push(
          window.setTimeout(() => {
            if (this.closed) return
            const full = buildMockArtifactContent(true)
            state.artifact = { ...newArtifactSnapshot(full), artifactId: state.artifact?.artifactId ?? '7556000000000000001' }
            r.dataPart({
              bizType: 'biz-side-manage-artifact-generated',
              params: {
                id: state.artifact.artifactId,
                version: '1',
                status: 'completed',
                content: full
              }
            })
          }, 400)
        )
        r.textPart(
          '主题内容已生成完成，概览如下：\n\n' +
            '| 产物 | 数量 |\n| --- | --- |\n| 场景单元 | 5 个 |\n| 客户画像 | 3 类 |\n| 冰山模型要素 | 6 层 |\n| 评估维度 | 5 个 |\n\n' +
            '每个场景都配置了 13 项内容与评估标准，评估维度权重合计 100。你可以逐项检查，确认后点右上角「确认」保存到主题。'
        )
        return
      }

      r.textPart(
        '收到。为了让训练主题更贴合你们的真实业务，我想再确认几点：\n\n' +
          '- 这次训练主要面向哪类岗位？\n' +
          '- 希望重点覆盖哪些业务场景？\n' +
          '- 有没有现成的材料（产品介绍/流程文档）可以上传？\n\n' +
          '你也可以直接把材料发给我，我来提取要点。'
      )
    })
  }

  /** 统一轮次包装：user-message-ack 已在外部推送，这里只跑 session-start 之后的序列 */
  private round(body: (r: FrameRound) => void): void {
    this.messageSeq += 1
    const messageId = `${randomHex(32)}_0`
    const r = new FrameRound((f) => this.push(f), messageId)
    r.openRound()
    body(r)
    r.finish()
  }

  private openingText(): string {
    if (state.topicCreated && state.artifact) {
      return '欢迎回到「柔性智造销售话术训练」的设计会话。当前右侧展示的是最近一次的工作区内容，你可以继续让我调整场景、画像或评估标准。'
    }
    return (
      '你好，我是 Nova —— 实战演练项目设计助手。\n\n' +
      '我可以帮你把业务目标变成一套可演练的训练主题，包含：\n\n' +
      '- 场景单元（业务目标、冰山要素、失败模式、时间限制）\n' +
      '- 客户画像与实战案例\n' +
      '- 评估维度与三档评分标准\n\n' +
      '先告诉我一些背景吧：这次训练面向**哪些岗位**？想解决**什么问题**？如果有产品资料或流程文档，也可以直接上传给我。'
    )
  }

  /** 供验收：手动模拟服务端断开（验证指数退避重连） */
  simulateDrop(): void {
    this.readyState = 3
    this.onclose?.({ code: 1006, reason: 'mock drop' })
  }

  close(): void {
    this.closed = true
    this.readyState = 3
    if (this.pingTimer !== null) window.clearInterval(this.pingTimer)
    this.timers.forEach((t) => window.clearTimeout(t))
    this.timers = []
    this.onclose?.({ code: 1000, reason: 'client close' })
  }
}

/** 场景 spec 里的案例正文（spec 未写 difficulty，统一补默认难度 2=正常） */
function withDifficulty(c: (typeof SCENARIO_SPECS)[number]['case']): ArtifactCase {
  return { ...c, difficulty: 2 }
}

/** 从场景 spec 取案例（供 mock 案例回填） */
function specCase(scenarioId: string): ArtifactCase {
  const spec = SCENARIO_SPECS.find((s) => s.id === scenarioId)
  return spec
    ? withDifficulty(spec.case)
    : {
        scriptName: 'A：实战案例',
        difficulty: 2,
        actorName: '客户',
        actorPosition: '负责人',
        scriptBackground: '',
        scriptOpening: ''
      }
}

export const MOCK_DELAY_MS = MOCK_DELAY