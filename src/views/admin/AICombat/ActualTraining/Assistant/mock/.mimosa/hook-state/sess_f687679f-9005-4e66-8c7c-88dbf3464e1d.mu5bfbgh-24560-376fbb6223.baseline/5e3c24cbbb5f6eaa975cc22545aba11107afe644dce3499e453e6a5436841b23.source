/**
 * AI 设计助手 Mock 数据与假帧生成
 *
 * 用途：后端 AI 助手模块（WS/Dify/artifact）尚未实现（after-end 仅有管理端模块），
 * 前端按 03-接口文档.md §3 的帧示例构造假帧序列，用于 FP-30~34 的联调与验收自查。
 * 联调后端就绪后把 api/assistant.ts 的 ASSISTANT_USE_MOCK 与假 WS 传输一并关掉即可，组件与 store 不改。
 *
 * 帧字段逐个对齐 §3.3 示例（含 type/timestamp/contentType/partExtendedData/messageExtendedData/seq）。
 */
import type {
  ArtifactCase,
  AssistantArtifactContent,
  AssistantArtifactSnapshot,
  AssistantMessageItem,
  AssistantScriptProgressResp,
  AssistantServerFrame,
  AssistantSessionResp,
  AssistantFileResp
} from '@/types/assistant'

